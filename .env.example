# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
# Same origin as BETTER_AUTH_URL — used by the browser auth client (`better-auth/react`)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Polar (optional — leave POLAR_ACCESS_TOKEN empty to skip the plugin; sign-up still works)
# https://better-auth.com/docs/plugins/polar
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
# POLAR_WEBHOOK_SECRET=  # when you add the `webhooks()` sub-plugin

# LIVEKIT_CREDENTIAL_ENCRYPTION_KEY, plus optional platform fallback envs LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, and LIVEKIT_SIP_OUTBOUND_TRUNK_ID.
LIVEKIT_CREDENTIAL_ENCRYPTION_KEY=your-livekit-encryption-key
LIVEKIT_URL=https://your-livekit-url.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-livekit-sip-outbound-trunk-id
