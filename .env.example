# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
# Same origin as BETTER_AUTH_URL — used by the browser auth client (`better-auth/react`)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# PostHog analytics (optional — skipped when unset)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Polar billing
# https://better-auth.com/docs/plugins/polar
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_CHECKOUT_SUCCESS_URL=http://localhost:3000/dashboard/billing?checkout=success
POLAR_CHECKOUT_RETURN_URL=http://localhost:3000/dashboard/billing
VOICE_CREDIT_EVENT_NAME=voice_credit_usage
# Temporary launch credits ($0.01 each). Set to 0 once paid billing is live.
SIGNUP_BONUS_CREDITS=200

# File storage for call recordings
# Uses files-sdk with private Vercel Blob by default.
FILE_STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_store_token
# Optional on Vercel when using Blob OIDC instead of a long-lived token.
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime when enabled.
BLOB_STORE_ID=store_your_blob_store_id

# Vercel AI Gateway for assistant responses
# On Vercel, OIDC can be used automatically when AI Gateway is enabled.
# For local dev, run `vercel env pull .env.local` for VERCEL_OIDC_TOKEN,
# or set a static AI_GATEWAY_API_KEY.
AI_GATEWAY_MODEL=deepseek/deepseek-v4-flash
AI_GATEWAY_ANALYSIS_MODEL=deepseek/deepseek-v4-flash
AI_GATEWAY_MAX_RETRIES=0
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
# VERCEL_OIDC_TOKEN is injected by Vercel or pulled locally by the Vercel CLI.

# Twilio is BYO for V1.
# Users save Twilio credentials in Settings. Leave these platform fallback vars unset
# unless you intentionally want one shared fallback Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DELETE_RECORDING_AFTER_BLOB_UPLOAD=false
# Local ConversationRelay testing needs a public HTTPS ngrok URL here.
# Run `bun run dev:voice` instead of `bun run dev` so the same ngrok tunnel
# can upgrade `/api/v1/relay/ws` to WebSocket.
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000

# Telnyx is also BYO for V1 (optional alternative to Twilio).
# Users save Telnyx credentials in Settings. Leave these platform fallback vars unset
# unless you intentionally want one shared fallback Telnyx account.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_APPLICATION_SID=
TELNYX_FROM_NUMBER=
TELNYX_DELETE_RECORDING_AFTER_BLOB_UPLOAD=false
TELNYX_WEBHOOK_BASE_URL=http://localhost:3000

# Required to encrypt per-user Twilio/Telnyx credentials and agent webhook secrets at rest.
# LIVEKIT_CREDENTIAL_ENCRYPTION_KEY is accepted as a legacy alias.
CREDENTIAL_ENCRYPTION_KEY=your-credential-encryption-key

# Parked LiveKit platform fallbacks (routes not mounted in production).
LIVEKIT_URL=https://your-livekit-url.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-livekit-sip-outbound-trunk-id
